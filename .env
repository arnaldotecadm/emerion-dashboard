# Base URL for the ERP backend REST API (customer, orders, etc.).
# Left empty by default so requests are relative and go through the Vite dev
# server proxy configured in vite.config.ts (avoids CORS issues in local dev).
# In production, set this to the deployed API's absolute URL and ensure that
# backend allows CORS for the frontend's origin.
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=eu-north-1_NtDQLSmuT
VITE_COGNITO_CLIENT_ID=395rpr7l5274ei0ivbjm6l2ptd
